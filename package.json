{
  "name": "aaidle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test:unit": "vitest run --config=tests/configs/vitest.config.ts",
    "test:install": "pnpm install --frozen-lockfile && pnpm exec playwright install --with-deps chromium",
    "test:watch": "vitest --config=tests/configs/vitest.config.ts",
    "test:e2e": "playwright test --config=tests/configs/playwright.config.ts --no-deps --project=chromium --project=mobile-chromium",
    "test:lighthouse": "playwright test --config=tests/configs/playwright.lighthouse.config.ts",
    "test:api": "playwright test --config=tests/configs/playwright.api.config.ts --no-deps --project=production-api",
    "test:api:local": "bash -c 'set -a && source .env && set +a && pnpm test:api'",
    "test:release-rediness": "playwright test --config=tests/configs/playwright.config.ts --project=release-readiness",
    "test:accessibility": "playwright test --config=tests/configs/playwright.accessibility.config.ts --no-deps --project=accessibility",
    "test:prod:e2e": "bash -c 'set -a && source .env && set +a && pnpm run test:e2e'",
    "test:prod:api": "bash -c 'set -a && source .env && set +a && pnpm run test:api'",
    "allure:e2e": "allure generate reports/allure-results --clean --output report-site/e2e",
    "allure:api": "allure generate reports/api-allure-results --clean --output report-site/api",
    "check": "pnpm ci:validate-actions && pnpm typecheck && pnpm lint && pnpm test",
    "ci:validate-actions": "node scripts/validate-workflow-action-pins.mjs",
    "db:validate-seed": "pnpm run validate-classic-data && pnpm run validate-emoji-data && pnpm run validate-timeline-data",
    "validate-classic-data": "node scripts/validate-classic-data.mjs",
    "validate-emoji-data": "node scripts/validate-emoji-data.mjs",
    "validate-timeline-data": "node scripts/validate-timeline-data.mjs",
    "format": "prettier --write . .github/scripts/**/*.mjs",
    "format:files": "prettier --write",
    "format:check": "prettier --check . .github/scripts/**/*.mjs",
    "classic-merge-to-one": "node scripts/classic-merge-to-one.mjs",
    "timeline-merge-to-one": "node scripts/timeline-merge-to-one.mjs",
    "timeline:seed": "pnpm timeline-merge-to-one"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.20",
    "matter-js": "^0.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "eslint": "^10.8.1",
    "get-port": "^7.2.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "playwright-lighthouse": "^4.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
