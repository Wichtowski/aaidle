{
  "name": "aaidle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm ci:validate-actions && pnpm typecheck && pnpm lint && pnpm test",
    "ci:validate-actions": "node scripts/validate-workflow-action-pins.mjs",
    "db:validate-seed": "node scripts/validate-model-data.mjs && node scripts/validate-emoji-data.mjs",
    "format": "prettier --write .",
    "format:files": "prettier --write",
    "format:check": "prettier --check .",
    "merge-many-to-one": "node scripts/merge-many-to-one.mjs",
    "split-one-to-many": "node scripts/split-one-to-many.mjs"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@tanstack/react-query": "^5.90.20",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
