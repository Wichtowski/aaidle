# Include this snippet inside the production aaidle.com site block.
# The API also sets its own security headers; the defer makes the static SPA
# responses receive the same baseline headers without overwriting API values.

header {
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://w.soundcloud.com; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; worker-src 'self'; frame-src https://w.soundcloud.com; upgrade-insecure-requests"
	X-Content-Type-Options "nosniff"
	X-Frame-Options "DENY"
	Referrer-Policy "strict-origin-when-cross-origin"
	Cross-Origin-Opener-Policy "same-origin"
	Permissions-Policy "camera=(), geolocation=(), microphone=()"
}
